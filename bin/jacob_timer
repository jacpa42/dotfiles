#!/usr/bin/dash
t=0
for a in $(echo "$*" | sed 's/[hms]/& /g'); do
  n=${a%?}
  case $a in
    *h) t=$((t + n * 3600)) ;;
    *m) t=$((t + n * 60)) ;;
    *s) t=$((t + n)) ;;
    *)  echo "bad: $a" >&2; exit 1 ;;
  esac
done

end=$(( $(date +%s) + t ))
while left=$(( end - $(date +%s) )); [ "$left" -gt 0 ]; do
  printf '\r%dm %02ds left ' $((left / 60)) $((left % 60))
  sleep 1
done

printf '\a\nDone\n'
notify-send "Timer done" "$*"
