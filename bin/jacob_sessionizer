#!/usr/bin/dash

TMUX_APP_ID="tmux"

choose_a_project() {
    TARGET_DIR="$(fd --format="{//}" -Hgtd .git -C "$PROJDIR" | fuzzel --dmenu --placeholder="Choose project")"
    [ -z "$TARGET_DIR" ] && exit 0 || TARGET_DIR="$PROJDIR/$TARGET_DIR"
    [ -d "$TARGET_DIR" ] || {
        notify-send -t 2000 "\"$TARGET_DIR\" is not a directory :("
        exit 1
    }
}

goto_project() {
    TARGET_DIR="$1"
    SESSION_NAME="$2"
    SESSION_CMD="$3"

    [ -d "$TARGET_DIR"   ] || exit 1
    [ -n "$SESSION_NAME" ] || exit 1
    [ -n "$SESSION_CMD"  ] || exit 1

    #
    # Make sure there is a window attached to tmux. If there isn't one, we
    # create one and exit
    #
    jacob_focuswindowclass "$TMUX_APP_ID" || {
        foot --app-id "$TMUX_APP_ID" -D "$TARGET_DIR" -T "$SESSION_NAME" tmux new-session -As "$SESSION_NAME" -c "$TARGET_DIR" -n bash "$SESSION_CMD" &
        for i in $(seq 100); do jacob_focuswindowclass "$TMUX_APP_ID" && exit; done
        exit
    }


    if [ "$(tmux display-message -p '#S')" = "$SESSION_NAME" ]; then
        tmux switch-client -p && exit
    else
        tmux has-session -t "$SESSION_NAME" && tmux switch-client -t "$SESSION_NAME" && exit
        tmux new-session -ds "$SESSION_NAME" -c "$TARGET_DIR" -n bash "$SESSION_CMD" && tmux switch-client -t "$SESSION_NAME" && exit
    fi

    exit 1
}

case "$1" in
gitweb)
    choose_a_project || exit 1

    cd "$TARGET_DIR"
    url="$(git config get remote.origin.url)"
    [ -z "$url" ] && {
        notify-send "Failed to find git url for \"$TARGET_DIR\""
        exit 0
    }

    default_browser="$(xdg-mime query default x-scheme-handler/https)"
    jacob_focuswindowclass "${default_browser%%.*}"
    exec xdg-open "$url"
    ;;
projects)
    choose_a_project || exit 1
    goto_project "$TARGET_DIR" "$(basename "$TARGET_DIR")" "nvim; $SHELL"
    ;;
scratch)
    goto_project "$HOME" "scratch" "$SHELL"
    ;;
*)
    echo "Provide a subcommand please"
    ;;

esac
