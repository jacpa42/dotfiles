#!/usr/bin/env /usr/bin/dash
# jacob_wallpaper [-r | -R | -s [name] | -S]    (no flag = next)

dir=${WALLPAPER_DIRECTORY:-$PROJDIR/muur_papier}
state=${XDG_CACHE_HOME:-$HOME/.cache}/lastwallpaper
read -r last 2>/dev/null <"$state"

mode=$1 want=${2:-$DEFAULT_WALLPAPER}

set -f; IFS='
'
set -- $(find "$dir" -type f -name '*.jxl' | sort)
[ $# -gt 0 ] || exit 1

# cur = position of the last wallpaper, def = first match for $want
n=0 cur=0
for f; do
    n=$((n + 1))
    case $f in "$last")   cur=$n ;; esac
    case $f in *"$want"*) def=${def:-$n} ;; esac
done

case $mode in
    "") i=$((cur % $# + 1)) ;;
    -r) i=$(((cur + $# - 2) % $# + 1)) ;;
    -R) i=$(($(od -An -N2 -tu2 /dev/urandom) % $# + 1)) ;;
    -s) [ -f "$want" ] && wp=$want || i=${def:-1} ;;
    -S) i=${cur#0}; i=${i:-${def:-1}} ;;
    *)  echo "usage: ${0##*/} [-r | -R | -s [name] | -S]" >&2; exit 1 ;;
esac

[ -n "$wp" ] || eval "wp=\${$i}"
case $wp in /*) ;; *) wp=$PWD/$wp ;; esac
printf '%s\n' "$wp" >"$state"
swaymsg -q output '*' bg "$wp" fill
