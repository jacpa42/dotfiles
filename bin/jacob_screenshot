#!/usr/bin/env dash

mode=""
for arg in "$@"; do
    case "$arg" in
    -r | --region) mode="region" ;;
    -w | --window) mode="window" ;;
    -o | --output) mode="output" ;;
    *) exit 1 ;;
    esac
done
[ -z "$mode" ] && mode="$(printf "region\nwindow\noutput" | fuzzel --dmenu --auto-select)"
[ -z "$mode" ] && exit

filename="$HOME/Pictures/screenshots/$(date +'%F-%N').png"

[ "$mode" = "region" ] && slurp | grim "$filename"
[ "$mode" = "window" ] && swaymsg -t get_tree |
    jq -r '.. | select(.pid? and .visible?) | "\(.rect.x+.window_rect.x),\(.rect.y+.window_rect.y) \(.window_rect.width)x\(.window_rect.height)"' |
    slurp | grim "$filename"
[ "$mode" = "output" ] && grim -o "$(swaymsg -t get_outputs | jq -r '.. | select(.active?) | .name')" "$filename"

notify-send -a screenshot -i "$filename" "screenshot taken" "Saved+copied screenshot."
wl-copy <"$filename"
