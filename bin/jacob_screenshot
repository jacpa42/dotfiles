#!/usr/bin/dash

mode="$1"
[ -z "$mode" ] && mode="$(printf "region\nwindow\noutput" | fuzzel --lines=3 --dmenu --auto-select)"
[ -z "$mode" ] && exit

mkdir -p "$HOME/Pictures/screenshots"
filename="$HOME/Pictures/screenshots/$(date +'%F-%N').png"

[ "$mode" = "region" ] && {
    DIM="$(slurp || exit)"
    grim -g "$DIM" "$filename"
}

[ "$mode" = "window" ] && {
    DIM="$(swaymsg -t get_tree | jq -r '.. | select(.pid? and .visible?) | "\(.rect.x+.window_rect.x),\(.rect.y+.window_rect.y) \(.window_rect.width)x\(.window_rect.height)"' | slurp)"
    grim -g "$DIM" "$filename" || exit
}

[ "$mode" = "output" ] && grim -o "$(swaymsg -t get_outputs | jq -r '.. | select(.active?) | .name')" "$filename"

[ -r "$filename" ] || exit 1

notify-send -a screenshot -i "$filename" "screenshot taken" "Saved+copied screenshot."
wl-copy <"$filename"

exec imv "$filename"
