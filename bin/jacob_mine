#!/usr/bin/env python3
"""jacob_mine — make Anki cards from the subtitle line you're watching in mpv.

  jacob_mine card VIDEO --time SEC ...   run by the mpv script (mine.lua) when you press Ctrl+m
  jacob_mine edit                        pick drafts with fzf and edit them in $EDITOR (nvim)
  jacob_mine push [--stage N]           send every draft to Anki (needs Anki open with AnkiConnect)

Mining the same line again replaces its draft. Pushing a draft again updates its Anki card.

push creates three note types with the same fields (the back always adds the furigana, translation,
word and notes). New cards go to stage 1; move cards along with Browse -> Notes -> Change Note Type.
  Mine 1 - hiragana + sound    video with sound + the sentence in hiragana
  Mine 2 - kanji + sound       video with sound + the sentence in kanji
  Mine 3 - kanji, silent       silent video + the sentence in kanji (the sound plays on the back)
Once they exist, the script never touches their layout again, so edit the templates freely.

Drafts go to /tmp/mine/<video>-<time>/: card.md (the text you edit) and clip.webm.
The English translation comes from an LLM: by default gemma3:27b through Ollama on localhost
(MINE_MODEL, ANTHROPIC_BASE_URL and ANTHROPIC_API_KEY change that). The notes are yours to write.
"""
import argparse, hashlib, html, json, os, re, shlex, shutil, subprocess, sys, tempfile, time, urllib.error, urllib.request
from pathlib import Path

OUT = Path(tempfile.gettempdir()) / "mine"
ANKI_URL = "http://127.0.0.1:8765"
DECK = "sentence-mine"
FIELDS = ["Sentence", "Word", "Reading", "Furigana", "English", "Notes", "Clip", "Source"]
MODELS = {1: "Mine 1 - hiragana + sound", 2: "Mine 2 - kanji + sound", 3: "Mine 3 - kanji, silent"}
CONTEXT = 15                                      # sentences of transcript either side, for the LLM
PAD = 0.25                                        # extra seconds of clip before and after the sentence
JP = re.compile(r"[぀-ヿ㐀-鿿]")
KANJI = re.compile(r"[㐀-鿿々]")
ENDS = tuple("。！？!?」』")                      # a sentence is finished
GOES_ON = ("、", "けど", "けれど", "ので", "のに", "ながら", "から")  # used when the subs have no 。
MAX_GAP, MAX_DUR = 1.2, 20.0                      # seconds: pause inside a sentence, longest sentence


LLM                = os.environ.get("MINE_MODEL", "gemma3:27b")
ANTHROPIC_BASE_URL = os.environ.get("ANTHROPIC_BASE_URL", "http://localhost:11434")
ANTHROPIC_API_KEY  = os.environ.get("ANTHROPIC_API_KEY", "local")


def die(msg):
    sys.exit(f"mine: {msg}")


def ffmpeg(*args):
    r = subprocess.run(["ffmpeg", "-v", "error", "-y", *map(str, args)], capture_output=True)
    if r.returncode:                              # drop ffmpeg's generic last lines; the cause is above them
        lines = [l for l in r.stderr.decode(errors="replace").strip().splitlines()
                 if not re.match(r"(Error opening output files?|Conversion failed|Error while|Nothing was written)", l)]
        raise RuntimeError(lines[-1] if lines else "ffmpeg failed")
    return r.stdout


# ---- subtitles -> sentences

def read_subs(src, stream):
    """Timed lines from one subtitle stream of src (a video or a subtitle file), via ffmpeg -> SRT."""
    try:
        srt = ffmpeg("-i", src, "-map", stream, "-f", "srt", "-").decode(errors="replace")
    except RuntimeError as e:
        die(f"can't read the subtitles: {e}")
    for block in re.split(r"\n\s*\n", srt.replace("\r", "")):
        head, _, text = block.strip().partition("\n")
        if "-->" not in head:
            head, _, text = text.partition("\n")
        times = re.findall(r"(\d+):(\d\d):(\d\d)[,.](\d{3})", head)
        if len(times) == 2:
            a, b = (int(h) * 3600 + int(m) * 60 + int(s) + int(ms) / 1000 for h, m, s, ms in times)
            yield a, b, text


def join(a, b):
    """Concatenate two subtitle pages, dropping text repeated across the break."""
    for k in range(min(len(a), len(b)), 1, -1):
        if a.endswith(b[:k]):
            return a + b[k:]
    return a + b


def strip_tags(text):
    return html.unescape(re.sub(r"\{[^}]*\}|<[^>]*>", "", text))


def clean(text):
    out = ""
    for line in strip_tags(text).replace("➡", "").split("\n"):
        out = join(out, re.sub(r"^[（(][^）)]{1,12}[）)]", "", line.strip(" 　")).strip(" 　"))  # （田中）
    return out


def sentences(cues):
    punctuated = sum(t.endswith(ENDS) for *_, t in cues) >= 0.3 * len(cues)
    out = []
    for s, e, t in cues:
        c = out[-1] if out else None
        if c and s - c["end"] <= MAX_GAP:
            if t == c["last"]:                    # same page shown twice
                c["end"] = e
                continue
            unfinished = not c["text"].endswith(ENDS) if punctuated else c["text"].endswith(GOES_ON)
            if unfinished and e - c["start"] <= MAX_DUR:
                c.update(text=join(c["text"], t), end=e, last=t)
                continue
        out.append({"start": s, "end": e, "text": t, "last": t})
    return out


def sentence_at(sents, t):
    """The sentence on screen at time t, else the one that just finished (you pressed the key a bit late)."""
    on = [i for i, x in enumerate(sents) if x["start"] - 0.2 <= t <= x["end"] + 0.5]
    if on:
        return on[-1]
    before = [i for i, x in enumerate(sents) if x["end"] <= t and t - x["end"] <= 3]
    if before:
        return before[-1]
    die("no Japanese subtitle line at this moment")


def japanese_audio(video):
    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "a", "-show_entries",
                          "stream=index:stream_tags=language,title", "-of", "json", str(video)], capture_output=True).stdout
    streams = json.loads(out or "{}").get("streams", [])
    for s in streams:
        tags = s.get("tags", {})
        if re.search(r"^(ja|jpn|jp|japanese)\b|日本語", tags.get("language", "") + " " + tags.get("title", ""), re.I):
            return s["index"]
    return streams[0]["index"] if streams else None


# ---- LLM (Anthropic Messages API; Ollama serves the same format)

TRANSLATE = """You translate Japanese subtitle lines from anime and other video into English for a learner's flashcards.
You get part of the transcript in order; the line to translate is marked >>> and repeated at the end.
Translate only that line, as natural English that stays close to the Japanese wording. Use the context to work
out omitted subjects and what things refer to, but don't add anything the line doesn't say.
Reply with only a JSON object: {"english": "..."}"""


def llm(system, user):
    """One request; returns the JSON object in the model's reply, or None if anything goes wrong."""
    base = ANTHROPIC_BASE_URL.rstrip("/")
    body = json.dumps({"model": LLM, "max_tokens": 600, "temperature": 0.2, "system": system,
                       "messages": [{"role": "user", "content": user}]}).encode()
    req = urllib.request.Request(base + "/v1/messages", body, {
        "x-api-key": ANTHROPIC_API_KEY, "anthropic-version": "2023-06-01",
        "content-type": "application/json"})
    for attempt in range(3):
        try:
            res = json.load(urllib.request.urlopen(req, timeout=600))
            text = "".join(b.get("text", "") for b in res.get("content", []) if b.get("type") == "text")
            return json.loads(re.search(r"\{.*\}", text, re.S)[0])
        except urllib.error.HTTPError as e:
            if e.code not in (429, 500, 502, 503, 529):
                print(f"mine: LLM request failed ({e.code}): {e.read().decode(errors='replace')[:300]}", file=sys.stderr)
                return None
        except (OSError, ValueError, TypeError) as e:   # unreachable, or the reply wasn't JSON: try again
            print(f"mine: LLM problem: {e}", file=sys.stderr)
        time.sleep(5 * (attempt + 1))
    return None


# ---- the editable card file

HELP = """# Type the word you're learning on the "word:" line; its reading is filled in on push if you leave it empty.
# Change anything you like. Lines starting with # are ignored. Delete everything to throw the card away."""


def write_card(path, f, context):
    lines = [f"word: {f['word']}", f"reading: {f['reading']}", f"sentence: {f['sentence']}",
             f"english: {f['english']}", "notes:", *(f"- {n}" for n in f["notes"]), "", HELP, "#", *context]
    path.write_text("\n".join(lines) + "\n")


def read_card(path):
    f, notes = {"word": "", "reading": "", "sentence": "", "english": ""}, None
    for line in path.read_text().splitlines():
        if line.startswith("#"):
            continue
        if notes is not None:
            notes.append(line)
        elif line.startswith("notes:"):
            notes = [line[6:].strip()]
        elif (m := re.match(r"(word|reading|sentence|english):(.*)$", line)):
            f[m[1]] = m[2].strip()
    f["notes"] = "\n".join(l for l in notes or [] if l.strip())
    return f


# ---- commands

def cmd_card(a):
    video = Path(a.video).resolve()
    if not video.exists():
        die(f"{video}: no such file (only local files work, not streams)")
    src, stream = (a.sub_file, "0:s:0") if a.sub_file else (video, f"0:{a.sub_stream}" if a.sub_stream is not None else "0:s:0")
    cues = sorted((s + a.sub_delay, e + a.sub_delay, clean(t)) for s, e, t in read_subs(src, stream))
    cues = [c for c in cues if JP.search(c[2])]
    if not cues:
        die("the current subtitle track isn't Japanese")
    sents = sentences(cues)
    i = sentence_at(sents, a.time)
    x = sents[i]

    s = int(x["start"])
    dest = OUT / f"{re.sub(r'[^\w.-]+', '_', video.stem)[:50]}-{s // 3600}h{s % 3600 // 60:02d}m{s % 60:02d}s"
    note_id = (dest / ".note_id").read_text() if (dest / ".note_id").exists() else None
    if dest.exists():                             # mining a line again replaces its draft
        shutil.rmtree(dest)
    dest.mkdir(parents=True)
    if note_id:                                   # but remembers its Anki card, so push updates that card
        (dest / ".note_id").write_text(note_id)
    (dest / ".drafting").touch()
    try:
        audio = f"0:{a.audio_stream}" if a.audio_stream is not None else f"0:{japanese_audio(video) or 'a:0'}"
        a0, dur = max(0, x["start"] - PAD), x["end"] + PAD - max(0, x["start"] - PAD)
        ffmpeg("-ss", a0, "-i", video, "-t", dur, "-map", f"0:{a.video_stream}" if a.video_stream is not None else "0:v:0",
               "-map", audio, "-vf", "scale=-2:'min(480,ih)'", "-pix_fmt", "yuv420p", "-c:v", "libvpx-vp9",
               "-crf", 36, "-b:v", 0, "-deadline", "good", "-cpu-used", 5, "-row-mt", 1,
               "-c:a", "libopus", "-b:a", "64k", "-ac", 2, dest / "clip.webm")
        (dest / "source.json").write_text(json.dumps({"title": video.stem, "time": x["start"]}, ensure_ascii=False))

        lo, hi = max(0, i - CONTEXT), i + CONTEXT + 1
        excerpt = "\n".join((">>> " if j == i else "    ") + y["text"] for j, y in enumerate(sents[lo:hi], lo))
        reference = ""
        if a.en_file or a.en_stream is not None:  # mpv's secondary subtitles, used as a hint for the model
            esrc, estream = (a.en_file, "0:s:0") if a.en_file else (video, f"0:{a.en_stream}")
            reference = " ".join(" ".join(strip_tags(t).split()) for s, e, t in read_subs(esrc, estream)
                                 if s + a.en_delay < x["end"] and e + a.en_delay > x["start"])
        f = {"word": "", "reading": "", "sentence": x["text"], "english": "", "notes": []}
        context = ["# Context:", *("#   " + line for line in excerpt.splitlines())]
        if reference:
            context.append(f"# English subtitle: {reference}")
        write_card(dest / "card.md", f, context)   # a usable card even if the LLM step fails

        prompt = excerpt + f"\n\nLine to translate: {x['text']}"
        if reference:
            prompt += f"\nA human subtitle translation of it, possibly loose: {reference}"
        got = llm(TRANSLATE, prompt)
        if got and str(got.get("english", "")).strip():
            f["english"] = str(got["english"]).strip()
            write_card(dest / "card.md", f, context)
    finally:
        (dest / ".drafting").unlink(missing_ok=True)
    print(f"card ready: {x['text']}" + ("" if f["english"] else " (no translation)"))


def drafts():
    return sorted((p.parent for p in OUT.glob("*/card.md")), key=lambda d: d.stat().st_mtime, reverse=True)


def cmd_list(a):
    """One line per draft for fzf: folder, sentence, English."""
    for d in drafts():
        f = read_card(d / "card.md")
        mark = "…" if (d / ".drafting").exists() else ("✓" if (d / ".note_id").exists() else " ")
        print(f"{d.name}\t{mark} {f['word'] or '-'}\t{f['sentence']}\t{f['english']}")


def cmd_edit(a):
    if not drafts():
        die("no drafts in " + str(OUT))
    if not shutil.which("fzf"):
        die("fzf isn't installed (sudo pacman -S fzf)")
    me = shlex.quote(os.path.abspath(sys.argv[0]))
    keys = "enter: edit · tab: select several · ctrl-p: play clip · ctrl-d: delete draft · ✓ = in Anki"
    pick = subprocess.run(["fzf", "--multi", "--delimiter", "\t", "--with-nth", "2..", "--header", keys,
                           "--preview", f"cat {OUT}/{{1}}/card.md", "--preview-window", "down:60%:wrap",
                           "--bind", f"ctrl-p:execute-silent(setsid mpv --really-quiet {OUT}/{{1}}/clip.webm >/dev/null 2>&1 &)",
                           "--bind", f"ctrl-d:execute-silent(rm -rf {OUT}/{{1}})+reload({me} list)"],
                          input=subprocess.run([sys.executable, sys.argv[0], "list"], capture_output=True, text=True).stdout,
                          stdout=subprocess.PIPE, text=True)
    editor = shlex.split(os.environ.get("EDITOR") or "nvim")
    for line in pick.stdout.splitlines():
        d = OUT / line.split("\t")[0]
        if subprocess.run([*editor, str(d / "card.md")]).returncode:
            break                                 # :cq in nvim stops here
        if not any(l.strip() and not l.startswith("#") for l in (d / "card.md").read_text().splitlines()):
            shutil.rmtree(d)
            print(f"{d.name}: thrown away")


# ---- furigana (pip install fugashi unidic-lite)

ROWS = {"ア": "アカサタナハマヤラワガザダバパァャ", "イ": "イキシチニヒミリギジヂビピィ", "ウ": "ウクスツヌフムユルグズヅブプゥュ",
        "エ": "エケセテネヘメレゲゼデベペェ", "オ": "オコソトノホモヨロヲゴゾドボポォョ"}


def hira(s):
    return "".join(chr(ord(c) - 0x60) if "ァ" <= c <= "ヶ" else c for c in s)


def reading_of(w):
    """Katakana reading of a token as written in kana (コウシ, not the pronunciation コーシ)."""
    f = w.feature
    kana = getattr(f, "kana", None)               # full UniDic has this field
    if kana and kana != "*":
        return kana
    pron, lemma = getattr(f, "pron", None), getattr(f, "lForm", None) or ""
    if not pron or pron == "*":
        return None
    out = ""                                      # unidic-lite: only pron, so turn each ー back into a vowel
    for i, ch in enumerate(pron):
        if ch == "ー" and out:
            if i < len(lemma) and lemma[i] in "アイウエオ":
                ch = lemma[i]
            else:
                v = next((v for v, row in ROWS.items() if out[-1] in row), "ー")
                ch = {"エ": "イ", "オ": "ウ"}.get(v, v)
        out += ch
    return out


def word_furigana(word, reading):
    """取り引き + トリヒキ -> ' 取[と]り 引[ひ]き'  (Anki's furigana syntax)"""
    if not reading or not KANJI.search(word):
        return word
    r = hira(reading)
    parts = re.findall(r"[㐀-鿿々]+|[^㐀-鿿々]+", word)
    m = re.fullmatch("".join("(.+?)" if KANJI.match(p) else re.escape(hira(p)) for p in parts), r)
    if not m:
        return f" {word}[{r}]"
    groups = iter(m.groups())
    return "".join(f" {p}[{next(groups)}]" if KANJI.match(p) else p for p in parts)


def furigana(text, tagger, span=None):
    """HTML-escaped sentence in furigana syntax, with the tokens inside span (start, end) in <b>."""
    out, pos = "", 0

    def bold(piece, a, b):
        return f"<b>{piece}</b>" if span and a < span[1] and b > span[0] else piece
    for w in (tagger(text) if tagger else []):
        k = text.find(w.surface, pos)
        if k < 0:
            continue
        if k > pos:
            out += bold(html.escape(text[pos:k]), pos, k)
        out += bold(word_furigana(html.escape(w.surface), reading_of(w)), k, k + len(w.surface))
        pos = k + len(w.surface)
    if pos < len(text):
        out += bold(html.escape(text[pos:]), pos, len(text))
    return out.strip().replace("</b><b>", "")


def find_word(word, sentence):
    """Where the word appears in the sentence, also when it's conjugated (食べる in 食べた)."""
    for n in range(len(word), 0, -1):
        k = sentence.find(word[:n])
        if k >= 0 and (n == len(word) or KANJI.search(word[:n]) or n >= 2):
            return k, k + n
    return None


# ---- push to Anki

CSS = """.card { font-family: "Noto Sans CJK JP", sans-serif; text-align: center; font-size: 20px; }
video { max-width: 100%; max-height: 360px; margin-top: 8px; }
.sentence { font-size: 32px; line-height: 1.9; margin: 16px 12px; }
.sentence b { color: #e0a030; }
ruby rt { font-size: 45%; opacity: .8; }
.english { font-size: 22px; margin: 12px; }
.word { font-size: 36px; margin-top: 10px; } .reading { font-size: 22px; opacity: .75; }
.notes { text-align: left; display: inline-block; max-width: 640px; font-size: 18px; margin: 8px 0; }
.src { font-size: 13px; opacity: .6; margin-top: 8px; }"""


def templates(stage):
    """Front and back of a stage's note type."""
    silent = stage == 3
    sentence = "{{kana:Furigana}}" if stage == 1 else "{{Sentence}}"
    front = (f'<div>{{{{#Clip}}}}<video src="{{{{Clip}}}}" autoplay controls{" muted" if silent else ""}></video>{{{{/Clip}}}}</div>'
             f'<div class="sentence">{sentence}</div>')
    back = (f'<div>{{{{#Clip}}}}<video src="{{{{Clip}}}}" controls{" autoplay" if silent else ""}></video>{{{{/Clip}}}}</div>'
            '<div class="sentence">{{furigana:Furigana}}</div><hr id="answer"><div class="english">{{English}}</div>'
            '{{#Word}}<div class="word">{{Word}}</div><div class="reading">{{Reading}}</div>{{/Word}}'
            '{{#Notes}}<div class="notes">{{Notes}}</div>{{/Notes}}<div class="src">{{Source}}</div>')
    return front, back


def anki(action, **params):
    req = urllib.request.Request(ANKI_URL, json.dumps({"action": action, "version": 6, "params": params}).encode())
    try:
        res = json.load(urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=60))
    except OSError:
        die("can't reach AnkiConnect — is Anki open with the add-on (2055492159) installed?")
    if res["error"]:
        raise RuntimeError(res["error"])
    return res["result"]


def cmd_push(a):
    ready = [d for d in reversed(drafts()) if not (d / ".drafting").exists()]
    if not ready:
        die("no drafts to push")
    try:
        import fugashi
        tagger = fugashi.Tagger()
    except Exception:
        tagger = None
        hint = "pip install --user --break-system-packages fugashi unidic-lite"
        if a.stage == 1:
            die(f"stage 1 shows the sentence in hiragana, which needs fugashi:\n  {hint}\n"
                "(or push at a kanji stage: jacob_mine push --stage 2)")
        print(f"mine: no furigana or automatic readings (to get them: {hint})", file=sys.stderr)

    have = anki("modelNames")
    for stage, name in MODELS.items():             # create any that are missing; never overwrite your edits
        if name not in have:
            front, back = templates(stage)
            anki("createModel", modelName=name, inOrderFields=FIELDS, css=CSS,
                 cardTemplates=[{"Name": "Card", "Front": front, "Back": back}])
            print(f"created note type '{name}'")
    anki("createDeck", deck=DECK)

    added = updated = 0
    for d in ready:
        f = read_card(d / "card.md")
        if not f["sentence"]:
            print(f"{d.name}: no sentence, skipped")
            continue
        word, sentence = f["word"], f["sentence"]
        reading = f["reading"] or (hira("".join(reading_of(w) or w.surface for w in tagger(word))) if word and tagger else "")
        span = find_word(word, sentence) if word else None
        plain = html.escape(sentence)
        if span:
            plain = (html.escape(sentence[:span[0]]) + f"<b>{html.escape(sentence[span[0]:span[1]])}</b>"
                     + html.escape(sentence[span[1]:]))
        meta = json.loads((d / "source.json").read_text()) if (d / "source.json").exists() else {"title": d.name, "time": 0}
        t = int(meta.get("time", 0))
        key = hashlib.md5(d.name.encode()).hexdigest()[:10]
        fields = {"Sentence": plain, "Word": html.escape(word), "Reading": html.escape(reading),
                  "Furigana": furigana(sentence, tagger, span) if tagger else plain,
                  "English": html.escape(f["english"]), "Notes": html.escape(f["notes"]).replace("\n", "<br>"),
                  "Source": f"{html.escape(meta['title'])} · {t // 60}:{t % 60:02d}",
                  }
        note = {"deckName": DECK, "modelName": MODELS[a.stage], "tags": ["sentence-mine"], "fields": fields,
                "options": {"allowDuplicate": False, "duplicateScope": "deck"}}
        if (d / "clip.webm").exists():             # "_" in the name stops Anki's media check calling it unused
            anki("storeMediaFile", filename=f"_mine_{key}.webm", path=str(d / "clip.webm"))
            fields["Clip"] = f"_mine_{key}.webm"
        note_id = int((d / ".note_id").read_text()) if (d / ".note_id").exists() else None
        if note_id and anki("notesInfo", notes=[note_id])[0].get("noteId"):
            anki("updateNoteFields", note={"id": note_id, "fields": fields})   # pushed before: update that card
            updated += 1
            continue
        try:
            (d / ".note_id").write_text(str(anki("addNote", note=note)))
            added += 1
        except RuntimeError as e:
            if "duplicate" not in str(e):
                die(f"{d.name}: {e}")
            print(f"{d.name}: this sentence is already in the deck from elsewhere, skipped")
    print(f"added {added} new cards to '{DECK}', updated {updated}")


def main():
    p = argparse.ArgumentParser(prog="jacob_mine", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sp = sub.add_parser("card", help="make a draft from the subtitle line at a time (run by mpv)")
    sp.add_argument("video")
    sp.add_argument("--time", type=float, required=True, help="playback position in seconds")
    sp.add_argument("--sub-file", help="external Japanese subtitle file")
    sp.add_argument("--sub-stream", help="the Japanese subtitle stream in the video, e.g. s:1")
    sp.add_argument("--sub-delay", type=float, default=0, help="mpv's sub-delay")
    sp.add_argument("--en-file", help="external English subtitle file (a hint for the LLM)")
    sp.add_argument("--en-stream", help="the English subtitle stream in the video, e.g. s:0")
    sp.add_argument("--en-delay", type=float, default=0)
    sp.add_argument("--audio-stream", help="the audio stream to use, e.g. a:1")
    sp.add_argument("--video-stream", help="the video stream, e.g. v:0")
    sub.add_parser("edit", help="pick drafts with fzf and edit them in $EDITOR (nvim)")
    sub.add_parser("list", help="list the drafts (used by edit)")
    sp = sub.add_parser("push", help="add the edited drafts to Anki")
    sp.add_argument("--stage", type=int, choices=MODELS, default=1, help="note type for the new cards (default 1)")
    a = p.parse_args()
    {"card": cmd_card, "edit": cmd_edit, "list": cmd_list, "push": cmd_push}[a.cmd](a)


if __name__ == "__main__":
    main()
