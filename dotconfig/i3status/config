general {
    colors = true
    color_good = "#a1a1a1"
    color_degraded = "#5f7a95"
    color_bad = "#7799bb"
    interval = 15
}

order += "wireless _first_"
order += "ethernet _first_"
order += "volume master"
order += "battery all"
order += "tztime local"

wireless _first_ {
    format_up = "W: (%quality at %essid) %ip"
    format_down = ""
}

ethernet _first_ {
    format_up = "E: %ip (%speed)"
    format_down = ""
}

battery all {
    format = "%status %percentage"
}

volume master {
    format = "♪: %volume"
    format_muted = "♪: muted (%volume)"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

tztime local {
    format = "%H:%M %d/%m/%y"
}
