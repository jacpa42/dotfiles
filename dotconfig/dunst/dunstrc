[global]
font = "JetBrainsMono Nerd Font 12"
frame_color = "#1b161e"
separator_color = frame
highlight = "#1b161e"
follow = keyboard
offset = (0, 0)

[urgency_low]
background = "#1b161e"
foreground = "#c1c1c1"

[urgency_normal]
background = "#1b161e"
foreground = "#556677"

[urgency_critical]
background = "#1b161e"
foreground = "#7799bb"
